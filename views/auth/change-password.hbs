{{>navbar}}
<main class="flex flex-col justify-center items-center h-full gap-3">
  <form hx-post="/auth/change-password" hx-indicator="#loading" hx-trigger="submit">
    <fieldset
      class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4"
      hx-post="/auth/validate/change-password"
      hx-indicator="#loading"
      hx-trigger="change, blur delay:500ms"
      hx-include="input"
    >
      <legend class="fieldset-legend">{{t 'lang.CHANGE_PASSWORD'}}</legend>

      <label class="label">{{t 'lang.CURRENT_PASSWORD'}}</label>
      <label class="input {{#if (filterErrors validationErrors "currentPassword")}}input-error{{/if}}">
        <input
          id="currentPassword"
          name="currentPassword"
          type="password"
          value="{{input.currentPassword}}"
          required
          placeholder="{{t 'lang.CURRENT_PASSWORD'}}"
          autocomplete="current-password"
        />
      </label>
      {{#each (filterErrors validationErrors "currentPassword")}}
      <p class="text-error">{{this}}</p>
      {{/each}}

      <label class="label">{{t 'lang.NEW_PASSWORD'}}</label>
      <label class="input {{#if (filterErrors validationErrors "newPassword")}}input-error{{/if}}">
        <input
          id="newPassword"
          name="newPassword"
          type="password"
          value="{{input.newPassword}}"
          required
          placeholder="{{t 'lang.NEW_PASSWORD'}}"
          autocomplete="new-password"
        />
      </label>
      {{#each (filterErrors validationErrors "newPassword")}}
      <p class="text-error">{{this}}</p>
      {{/each}}

      <label class="label">{{t 'lang.CONFIRM_PASSWORD'}}</label>
      <label class="input {{#if (filterErrors validationErrors "confirmPassword")}}input-error{{/if}}">
        <input
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          value="{{input.confirmPassword}}"
          required
          placeholder="{{t 'lang.NEW_PASSWORD'}}"
          autocomplete="new-password"
        />
      </label>
      {{#each (filterErrors validationErrors "confirmPassword")}}
      <p class="text-error">{{this}}</p>
      {{/each}}

      <button type="submit" id="submit" class="btn btn-neutral mt-4 {{#if validationErrors}}btn-disabled{{/if}}">{{t 'lang.CHANGE_PASSWORD'}}</button>
    </fieldset>
  </form>
</main>
{{>dock}}
